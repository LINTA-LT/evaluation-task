<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="1.0"
           targetNamespace="http://vpb.lt/open-data/schemas/trademark/v1-2"
           xmlns="http://vpb.lt/open-data/schemas/trademark/v1-2"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cc="http://vpb.lt/open-data/schemas/iso3166-1-extended-country-code/v1-1"
           xmlns:lc="http://vpb.lt/open-data/schemas/iso639-language-code/v1"
           xmlns:addr="http://vpb.lt/open-data/schemas/address/v1-1"
           elementFormDefault="qualified">

    <xs:annotation>
        <xs:documentation>
        </xs:documentation>
    </xs:annotation>

    <xs:import schemaLocation="iso3166-1-extended-country-code-v1-1.xsd" namespace="http://vpb.lt/open-data/schemas/iso3166-1-extended-country-code/v1-1"/>
    <xs:import schemaLocation="iso639-language-code-v1.xsd" namespace="http://vpb.lt/open-data/schemas/iso639-language-code/v1"/>
    <xs:import schemaLocation="address-v1-1.xsd" namespace="http://vpb.lt/open-data/schemas/address/v1-1"/>

    <xs:element name="TradeMark" type="TradeMarkType"/>

    <xs:complexType name="TradeMarkType">
        <xs:sequence>

            <xs:element name="ApplicationNumber" type="xs:token"/>
            <xs:element name="ApplicationDate" type="xs:date"/>
            <!-- INID (12) - ApplicationLanguageCode -->
            <xs:element name="ApplicationLanguageCode" type="lc:ISO639LanguageCodeType" default="lt"/>
            <xs:element name="RegistrationNumber" type="xs:string" minOccurs="0"/>
            <xs:element name="RegistrationDate" type="xs:date" minOccurs="0"/>

            <xs:element name="ExpiryDate" type="xs:date" minOccurs="0"/>

            <xs:element name="MarkCurrentStatusCode" type="MarkCurrentStatusCodeType" minOccurs="0"/>
            <xs:element name="MarkCurrentStatusDate" type="xs:date" minOccurs="0"/>

            <xs:element name="KindMark" type="KindMarkType" minOccurs="0"/>
            <xs:element name="MarkFeature" type="MarkFeatureType"/>
            <xs:element name="OppositionPeriodStartDate" type="xs:date" minOccurs="0"/>
            <xs:element name="OppositionPeriodEndDate" type="xs:date" minOccurs="0"/>
            <xs:element name="MarkDescriptionDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="MarkDescription" type="xs:token" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="MarkDisclaimerDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="MarkDisclaimer" type="xs:token" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="WordMarkSpecification" type="WordMarkSpecificationType" minOccurs="0"/>

            <xs:element name="MarkImageDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="MarkImage" type="MarkImageType"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="GoodsServicesDetails">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="GoodsServices" type="GoodsServicesType" minOccurs="0"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="PriorityDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Priority" type="PriorityType" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="ExhibitionPriorityDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ExhibitionPriority" type="ExhibitionPriorityType" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="PublicationDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Publication" type="PublicationType" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="SeniorityDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="SeniorityBeenClaimedNumber" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="ApplicantDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Applicant" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="PersonType" type="xs:token"/>
                                    <xs:element name="AddressBook" type="addr:AddressType"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="RepresentativeDetails" minOccurs="0">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="Representative" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:sequence>
                                    <xs:element name="PersonType" type="xs:token"/>
                                    <xs:element name="AddressBook" type="addr:AddressType"/>
                                </xs:sequence>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MarkImageType">
        <xs:sequence>
            <xs:element name="MarkImageURI" type="URIType"/>
            <xs:element name="MarkImageColourClaimedText" type="xs:token" minOccurs="0"/>
            <xs:element name="MarkImageCategory" type="MarkImageCategoryType" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="MarkImageCategoryType">
        <xs:sequence>
            <xs:element name="CategoryCodeDetails">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="CategoryCode" type="CategoryCodeType" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="CategoryCodeType">
        <xs:union memberTypes="xs:token">
            <xs:simpleType>
                <xs:restriction base="xs:string">
                    <xs:pattern value="[0-9][0-9].[0-9][0-9].[0-9][0-9]|[0-9][0-9].[0-9][0-9]"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:union>
    </xs:simpleType>


    <xs:complexType name="URIType">
        <xs:simpleContent>
            <xs:extension base="xs:anyURI"/>
        </xs:simpleContent>
    </xs:complexType>


    <xs:complexType name="TextType">
        <xs:simpleContent>
            <xs:extension base="xs:string">
                <xs:attribute name="languageCode" type="xs:language"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>


    <xs:simpleType name="KindMarkType">
        <xs:restriction base="xs:token">
            <xs:enumeration value="Individual" />
            <xs:enumeration value="Collective" />
            <xs:enumeration value="Guarantee" />
            <xs:enumeration value="Certificate" />
        </xs:restriction>
    </xs:simpleType>


    <xs:simpleType name="MarkCurrentStatusCodeType">
        <xs:restriction base="xs:token">
            <xs:enumeration value="Application filed" />
            <xs:enumeration value="Application published" />
            <xs:enumeration value="Application refused" />
            <xs:enumeration value="Application withdrawn" />
            <xs:enumeration value="Application opposed" />
            <xs:enumeration value="Registered" />
            <xs:enumeration value="Appeal pending" />
            <xs:enumeration value="Registration opposed" />
            <xs:enumeration value="Registration cancellation pending" />
            <xs:enumeration value="Registration cancelled" />
            <xs:enumeration value="Registration surrendered" />
            <xs:enumeration value="Expired" />
            <xs:enumeration value="Ended" />
            <xs:enumeration value="Revocation pending"/>
            <xs:enumeration value="Invalidation pending"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="MarkFeatureType">
        <xs:restriction base="xs:token">
            <xs:enumeration value="Word" />
            <xs:enumeration value="Stylized characters" />
            <xs:enumeration value="Figurative" />
            <xs:enumeration value="Combined" />
            <xs:enumeration value="3-D" />
            <xs:enumeration value="Colour" />
            <xs:enumeration value="Combination of colours" />
            <xs:enumeration value="General mark" />
            <xs:enumeration value="Sound" />
            <xs:enumeration value="Hologram" />
            <xs:enumeration value="Olfactory" />
            <xs:enumeration value="Motion" />
            <xs:enumeration value="Multimedia" />
            <xs:enumeration value="Position"/>
            <xs:enumeration value="Pattern"/>
            <xs:enumeration value="Municipal" />
            <xs:enumeration value="Chimney" />
            <xs:enumeration value="Kennfaden" />
            <xs:enumeration value="Number" />
            <xs:enumeration value="Packing" />
            <xs:enumeration value="Other" />
            <xs:enumeration value="Undefined" />
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="NiceClassNumberType">
        <xs:restriction base="xs:positiveInteger">
            <xs:maxInclusive value="45"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="PublicationSectionType">
        <xs:restriction base="xs:token">
            <xs:enumeration value="Application"/>
            <xs:enumeration value="Registration"/>
            <xs:enumeration value="Renewal"/>
        </xs:restriction>
    </xs:simpleType>


    <xs:complexType name="WordMarkSpecificationType">
        <xs:sequence>
            <xs:element name="MarkVerbalElementText" type="TextType"/>
        </xs:sequence>
    </xs:complexType>


    <xs:complexType name="GoodsServicesType">
        <xs:sequence>
            <xs:element name="ClassDescriptionDetails">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="ClassDescription" type="ClassDescriptionType" maxOccurs="unbounded"/>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PriorityType">
        <xs:sequence>
            <xs:element name="PriorityCountryCode" type="cc:ExtendedISO3166CountryCodeType"/>
            <xs:element name="PriorityNumber" type="xs:token"/>
            <xs:element name="PriorityDate" type="xs:date"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ExhibitionPriorityType">
        <xs:sequence>
            <xs:element name="ExhibitionCountryCode" type="cc:ExtendedISO3166CountryCodeType" minOccurs="0"/>
            <xs:element name="ExhibitionName" type="xs:string" minOccurs="0"/>
            <xs:element name="ExhibitionDate" type="xs:date" minOccurs="0"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="PublicationType">
        <xs:sequence>
            <xs:element name="PublicationIdentifier" type="xs:string" minOccurs="0"/>
            <xs:element name="PublicationSection" type="PublicationSectionType"/>
            <xs:element name="PublicationDate" type="xs:date"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="ClassDescriptionType">
        <xs:sequence>
            <xs:element name="ClassNumber" type="NiceClassNumberType" minOccurs="0"/>
            <xs:element name="GoodsServicesDescription" type="TextType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>


</xs:schema>
