<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<bindings xmlns="http://java.sun.com/xml/ns/jaxb" xmlns:xs="http://www.w3.org/2001/XMLSchema"
			   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		  xsi:schemaLocation="http://java.sun.com/xml/ns/jaxb http://java.sun.com/xml/ns/jaxb/bindingschema_2_0.xsd"
			   version="2.1">

	<globalBindings>
		<javaType
				name="org.joda.time.DateTime"
				xmlType="xs:dateTime"
				parseMethod="lt.gov.vpb.pdb.springbatch.util.XSDDateTimeToJodaDateTimeMarshaller.unmarshal"
				printMethod="lt.gov.vpb.pdb.springbatch.util.XSDDateTimeToJodaDateTimeMarshaller.marshal"
				/>
		<javaType
				name="org.joda.time.LocalDate"
				xmlType="xs:date"
				parseMethod="lt.gov.vpb.pdb.springbatch.util.XSDDateToJodaLocalDateMarshaller.unmarshal"
				printMethod="lt.gov.vpb.pdb.springbatch.util.XSDDateToJodaLocalDateMarshaller.marshal"
				/>
	</globalBindings>
</bindings>
